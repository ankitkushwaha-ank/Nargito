{
  "name": "nargito",
  "version": "1.0.0",
  "private": true,
  "description": "NARGITO - social networking, travel and enquiry marketplace platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npm run db:setup && next start",
    "start:fast": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "art": "tsx scripts/make-art.ts && tsx scripts/make-brand.ts",
    "db:setup": "tsx scripts/migrate.ts && tsx --conditions=react-server scripts/seed.ts",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "icons": "tsx scripts/make-icons.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@electric-sql/pglite": "0.5.10",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.57.0",
    "next": "15.5.28",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bcryptjs": "2.4.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "autoprefixer": "10.6.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.19",
    "vitest": "5.0.4"
  }
}
