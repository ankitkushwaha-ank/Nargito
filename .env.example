# NARGITO production environment
# Copy to .env (or set these in your host's dashboard). Never commit the real file.

NODE_ENV=production

# Public https URL of the site, no trailing slash. Used for emails, share links,
# Open Graph previews, sitemap and OAuth redirects.
APP_URL=https://nargito.in

# PostgreSQL connection string. Leave EMPTY to use the built-in database stored in .data/pglite
# (needs a host with a persistent disk). Set it for a managed PostgreSQL.
# Example: postgres://nargito:STRONG_PASSWORD@db-host:5432/nargito
DATABASE_URL=
DATABASE_POOL_MAX=10

# First admin account created by `npm run db:setup`.
SEED_ADMIN_EMAIL=admin@nargito.in
# Pick a long password. Change it again after first login.
SEED_ADMIN_PASSWORD=
# Demo members, trips, shops and products are created on first start so the site is never empty.
# Set to 0 for a clean database with only the admin account.
SEED_SAMPLE=1

# Uploaded files and admin-uploaded logo/banners. Mount a persistent disk here and back it up.
UPLOAD_DIR=/var/data/nargito/uploads

# Secret for scheduled jobs: POST /api/cron/<job> with header "Authorization: Bearer <value>".
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Email (pick one). Without this no emails or OTP codes are delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# RESEND_API_KEY=

# Optional: social login (redirect URI: ${APP_URL}/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Optional: payments and SMS
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
