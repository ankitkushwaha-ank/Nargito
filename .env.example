# ───────────── Core ─────────────
NODE_ENV=development
# Public origin of the site (used in emails, OAuth redirect URIs, sitemap). No trailing slash.
APP_URL=http://localhost:3000

# ───────────── Database ─────────────
# PostgreSQL (production / docker compose):  postgres://nargito:nargito@localhost:5432/nargito
# Leave empty (or "pglite:.data/pglite") to use the embedded PostgreSQL (PGlite) for local development.
DATABASE_URL=
DATABASE_POOL_MAX=10

# ───────────── Seed (development) ─────────────
SEED_ADMIN_EMAIL=admin@nargito.local
# If empty a random password is generated and printed once by `npm run db:seed`.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=Nargito-demo-123
# Set to 1 to also create sample users/content in production-like environments.
SEED_SAMPLE=

# ───────────── Storage ─────────────
# Local disk by default. Back this directory up and mount it as a persistent volume in production.
UPLOAD_DIR=.data/uploads

# ───────────── OAuth (server-side secrets only) ─────────────
# Redirect URI to register with BOTH providers:  ${APP_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ───────────── Email (choose one in Admin > Email & SMS) ─────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# ───────────── SMS ─────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ───────────── Payments (Pro) ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ───────────── AI (optional, disabled unless set + enabled in admin) ─────────────
AI_API_KEY=

# ───────────── Jobs / monitoring ─────────────
# Shared secret for POST /api/cron/<job> (use with an external scheduler). Generate a long random value.
CRON_SECRET=
# Optional error monitoring DSN (not wired to an SDK in this release; logs go to Admin > System logs).
SENTRY_DSN=
# Optional backup bookkeeping shown in Admin > Backup status.
BACKUP_LAST_RUN_FILE=
BACKUP_DESCRIPTION=
